{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch MyApp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_debug/main_application/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\Qt\\Tools\\mingw1120_64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Intel disassembly",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Break on abort",
                    "text": "break abort",
                    "ignoreFailures": true
                },
                {
                    "description": "Catch abort signal",
                    "text": "handle SIGABRT stop",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}